</section>

<section id="contact" class="contact">
  <div class="inner">
    <h2>Contact Us</h2>
    <div class="subtitle">Tell us what you need and we’ll get back to you.</div>

    <div class="contact-grid">
      <div>
        <p>Looking to buy, sell or rent a property in Malaysia? Reach out to IQI Malaysia today.</p>
        <p class="contact-info-item">
          <span>Phone / WhatsApp:</span> +60 12-345 6789
        </p>
        <p class="contact-info-item">
          <span>Email:</span> info@iqimalaysia.com
        </p>
        <p class="contact-info-item">
          <span>Office:</span> Kuala Lumpur, Malaysia
        </p>
        <span class="contact-badge">Response within 1 business day</span>
        <div style="margin-top:12px;">
          <!-- CONTACT WHATSAPP BUTTON - REPLACE YOUR_PHONE_NUMBER -->
          <a
            class="btn btn-whatsapp"
            href="https://wa.me/YOUR_PHONE_NUMBER?text=Hi%20IQI%20Malaysia%2C%20I%20would%20like%20to%20talk%20about%20buying%2Fselling%20a%20property."
            target="_blank"
            rel="noopener"
          >
            Chat on WhatsApp Now
          </a>
        </div>
      </div>

      <form class="contact-form" onsubmit="event.preventDefault(); alert('Thank you! We will contact you shortly. (Demo only)');">
        <label for="name">Name</label>
        <input id="name" type="text" required />

        <label for="phone">Phone / WhatsApp</label>
        <input id="phone" type="tel" required />

        <label for="email">Email</label>
        <input id="email" type="email" />

        <label for="type">I am interested in</label>
        <select id="type">
          <option>Buying</option>
          <option>Selling</option>
          <option>Renting</option>
          <option>Property investment</option>
          <option>New projects</option>
          <option>Other</option>
        </select>

        <label for="message">Details</label>
        <textarea id="message" placeholder="Area, budget, property type, preferred projects, etc." required></textarea>

        <button type="submit">Submit Enquiry</button>
      </form>
    </div>
  </div>
</section>

<footer>
  &copy; <span id="year"></span> IQI Malaysia. All rights reserved.
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>

